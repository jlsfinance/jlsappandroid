rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Safely evaluates company access without crashing on null user documents or missing companies arrays
    function canAccessCompany(cid) {
      return request.auth != null && cid != null && (
        (exists(/databases/$(database)/documents/companies/$(cid))
         && get(/databases/$(database)/documents/companies/$(cid)).data.ownerEmail == request.auth.token.email)
        || (exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && cid == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companyId)
        || (exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && "companies" in get(/databases/$(database)/documents/users/$(request.auth.uid)).data
            && cid in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.companies)
      );
    }

    // Business Data Permission Helpers
    function canReadBusinessData() {
      return request.auth != null && (
        resource == null || canAccessCompany(resource.data.companyId)
      );
    }

    function canCreateBusinessData() {
      return request.auth != null
        && request.resource.data.companyId != null
        && canAccessCompany(request.resource.data.companyId)
        && (!('ownerEmail' in request.resource.data) || request.resource.data.ownerEmail == request.auth.token.email);
    }

    // Task 1 & Task 2: Protect companyId and ownerEmail from post-creation modification
    function canUpdateBusinessData() {
      return request.auth != null
        && resource != null
        && canAccessCompany(resource.data.companyId)
        && request.resource.data.companyId == resource.data.companyId
        && (!('ownerEmail' in resource.data) || request.resource.data.ownerEmail == resource.data.ownerEmail);
    }

    function canDeleteBusinessData() {
      return request.auth != null && resource != null && canAccessCompany(resource.data.companyId);
    }

    // Customer authentication via Custom Token (no email, no /users/{uid} doc)
    function isCustomer() {
      return request.auth != null && request.auth.token.role == 'customer'
        && request.auth.token.customerDocId != null
        && request.auth.token.companyId != null;
    }

    function getCustomerDocId() {
      return request.auth.token.customerDocId;
    }

    function getCustomerCompanyId() {
      return request.auth.token.companyId;
    }

    // ─── Plan enforcement helpers (ternary-only, CEL subset) ────────
    function getTier(raw) {
      return raw.matches('^enterprise') ? 'enterprise'
        : raw.matches('^pro') ? 'pro'
        : raw.matches('^starter') ? 'starter'
        : 'free';
    }
    function planOf(uid) {
      let sub = get(/databases/$(database)/documents/subscriptions/$(uid));
      return sub.data != null && sub.data.status in ['active', 'trialing', 'past_due', 'cancelled']
        ? getTier(sub.data.planId)
        : 'free';
    }
    function usageCount(uid, field) {
      return get(/databases/$(database)/documents/usage/$(uid)).data != null
        && field in get(/databases/$(database)/documents/usage/$(uid)).data
        ? get(/databases/$(database)/documents/usage/$(uid)).data[field]
        : 0;
    }
    function canAddCustomerForPlan(uid) {
      return planOf(uid) == 'enterprise'
        ? true
        : planOf(uid) == 'pro'
          ? usageCount(uid, 'customers') < 100
          : planOf(uid) == 'starter'
            ? usageCount(uid, 'customers') < 50
            : usageCount(uid, 'customers') < 10;
    }
    function canCreateLoanForPlan(uid, tenure) {
      return planOf(uid) == 'enterprise'
        ? true
        : planOf(uid) == 'pro'
          ? tenure <= 60
          : planOf(uid) == 'starter'
            ? tenure <= 36
            : tenure <= 24;
    }
    function canCreateDepositForPlan(uid, tenure) {
      return planOf(uid) == 'enterprise' || planOf(uid) == 'pro'
        ? tenure <= (planOf(uid) == 'enterprise' ? 9999 : 60)
        : planOf(uid) == 'starter'
          ? tenure <= 36
          : false;
    }
    function canAddCompanyForPlan(uid) {
      return planOf(uid) == 'enterprise'
        ? true
        : usageCount(uid, 'companies') < 1;
    }
    // ───────────────────────────────────────────────────────────

    // Companies: owner can read/create/update/delete, assigned company users can read
    match /companies/{document} {
      allow read: if request.auth != null
        && ((resource != null && resource.data.ownerEmail == request.auth.token.email)
            || canAccessCompany(document));
      allow create: if request.auth != null
        && request.resource.data.ownerEmail == request.auth.token.email
        && canAddCompanyForPlan(request.auth.uid);
      allow update, delete: if request.auth != null
        && resource.data.ownerEmail == request.auth.token.email;
    }

    // Business Data Collections: Company-Isolated Access & Immutable companyId/ownerEmail
    match /customers/{document} {
      allow read: if canReadBusinessData()
        || (isCustomer() && document == getCustomerDocId());
      allow create: if canCreateBusinessData()
        && canAddCustomerForPlan(request.auth.uid);
      allow update: if canUpdateBusinessData();
      allow delete: if canDeleteBusinessData();
    }

    match /loans/{document} {
      allow read: if canReadBusinessData()
        || (isCustomer() && resource != null && resource.data.customerId == getCustomerDocId());
      allow create: if canCreateBusinessData()
        && canCreateLoanForPlan(request.auth.uid, request.resource.data.tenure);
      allow update: if canUpdateBusinessData();
      allow delete: if canDeleteBusinessData();
    }

    match /deposits/{document} {
      allow read: if canReadBusinessData();
      allow create: if canCreateBusinessData()
        && canCreateDepositForPlan(request.auth.uid, request.resource.data.tenure);
      allow update: if canUpdateBusinessData();
      allow delete: if canDeleteBusinessData();
    }

    // ponytail: Intentionally unlimited — business expenses tracking has no practical ceiling
    match /expenses/{document} {
      allow read: if canReadBusinessData();
      allow create: if canCreateBusinessData();
      allow update: if canUpdateBusinessData();
      allow delete: if canDeleteBusinessData();
    }

    // ponytail: Intentionally unlimited — accounting ledger entries are per-transaction, not per-customer
    match /ledger/{document} {
      allow read: if canReadBusinessData();
      allow create: if canCreateBusinessData();
      allow update: if canUpdateBusinessData();
      allow delete: if canDeleteBusinessData();
    }

    // ponytail: Intentionally unlimited — investor transactions track capital flow, not customer count
    match /partner_transactions/{document} {
      allow read: if canReadBusinessData();
      allow create: if canCreateBusinessData();
      allow update: if canUpdateBusinessData();
      allow delete: if canDeleteBusinessData();
    }

    // ponytail: Intentionally unlimited — partner/business-relationship records are low-volume by nature
    match /partners/{document} {
      allow read: if canReadBusinessData();
      allow create: if canCreateBusinessData();
      allow update: if canUpdateBusinessData();
      allow delete: if canDeleteBusinessData();
    }

    // ponytail: Intentionally unlimited — one receipt per loan/deposit transaction, no ceiling
    match /receipts/{document} {
      allow read: if canReadBusinessData();
      allow create: if canCreateBusinessData();
      allow update: if canUpdateBusinessData();
      allow delete: if canDeleteBusinessData();
    }

    // Counters: Server-side Cloud Functions only for writes
    match /counters/{document} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Users: own doc by uid (read+write); lookup by email allowed for role/company resolution
    match /users/{document} {
      allow read: if request.auth != null && (
        request.auth.uid == document
        || (resource != null && resource.data.email == request.auth.token.email)
        || (resource != null && resource.data.companyId != null && canAccessCompany(resource.data.companyId))
      );
      allow write: if request.auth != null && request.auth.uid == document && (
        resource == null
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(["name", "fcmToken"])
      );
    }

    // Task 3: Notifications (Strict existing document READ rule without resource == null)
    match /notifications/{document} {
      allow read: if request.auth != null && resource != null && (
        canAccessCompany(resource.data.companyId)
        || resource.data.recipientId == request.auth.uid
        || (isCustomer()
            && resource.data.companyId == getCustomerCompanyId()
            && (resource.data.recipientId == 'all'
                || resource.data.recipientId == getCustomerDocId()
                || resource.data.recipientId == request.auth.uid))
      );
      allow create: if request.auth != null && (
        request.resource.data.companyId != null
        && canAccessCompany(request.resource.data.companyId)
      );
      allow update: if canUpdateBusinessData();
      allow delete: if canDeleteBusinessData();
    }

    // Subscriptions: Users can read their subscription; WRITES RESTRICTED TO CLOUD FUNCTIONS (Admin SDK)
    match /subscriptions/{document} {
      allow read: if request.auth != null && (
        request.auth.uid == document
        || (resource != null && resource.data.userId == request.auth.uid)
        || (resource != null && resource.data.userEmail == request.auth.token.email)
      );
      allow write: if false;
    }

    // Payments & Payment History: WRITES RESTRICTED TO CLOUD FUNCTIONS / ADMIN SDK ONLY
    match /payments/{document} {
      allow read: if request.auth != null && (
        (resource != null && resource.data.userId == request.auth.uid)
        || (resource != null && resource.data.userEmail == request.auth.token.email)
      );
      allow write: if false;
    }

    match /payment_history/{document} {
      allow read: if request.auth != null && (
        (resource != null && resource.data.userId == request.auth.uid)
        || (resource != null && resource.data.userEmail == request.auth.token.email)
      );
      allow write: if false;
    }

    // Subscription Logs: Audit logs for subscription actions
    match /subscription_logs/{document} {
      allow read: if request.auth != null && (
        (resource != null && resource.data.userId == request.auth.uid)
        || (resource != null && resource.data.userEmail == request.auth.token.email)
      );
      allow write: if false;
    }

    // Usage Collection: READ-ONLY FOR CLIENTS; WRITES RESTRICTED TO CLOUD FUNCTIONS / ADMIN SDK ONLY
    match /usage/{document} {
      allow read: if request.auth != null && (
        request.auth.uid == document
        || (resource != null && resource.data.userId == request.auth.uid)
      );
      allow write: if false;
    }

    // System subtree: internal metrics, audit logs, config — admin SDK only
    match /companies/{companyId}/system/{document=**} {
      allow read: if canReadBusinessData();
      allow write: if false;
    }

    // Metrics dedup: Cloud Functions only (admin SDK), never client-accessible
    match /_metricsDedup/{document} {
      allow read, write: if false;
    }

    // Fallback: deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
